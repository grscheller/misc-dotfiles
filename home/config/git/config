#
# Settings shared across all systems.
#
[user]
	name = grscheller
	email = geoffrey@scheller.com
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[core]
	editor = nvim
	fsmonitor = false
	pager = nvim -R -c 'set filetype=git'
	autocrlf = false
[color]
	pager = no
[pull]
	rebase = false
[init]
	defaultBranch = main
[rerere]
	enabled = true
#
# Local settings, silently ignored by git when absent.
#
[include]
	path = local
